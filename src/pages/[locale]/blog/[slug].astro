---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import LocalizedPostCard from "../../../components/LocalizedPostCard.astro";
import { activeLocales } from "../../../data/active-locales";
import { comparisonSlugs, isPublishedLocale, type ComparisonSlug, type Locale } from "../../../data/locales";
import { comparisonSources, localizedArticles } from "../../../data/localized-articles";
import { localizedPages } from "../../../data/localized-pages";
import { site } from "../../../data/site";

export function getStaticPaths() {
  return activeLocales().flatMap(({ slug: locale }) => comparisonSlugs.map((slug) => ({ params: { locale, slug } })));
}
const locale = Astro.params.locale as Locale;
const slug = Astro.params.slug as ComparisonSlug;
const copy = localizedArticles[locale]?.[slug];
const labels = localizedPages[locale]?.ui;
if (!copy || !labels) throw new Error(`Missing localized article: ${locale}/${slug}`);
const url = `${site.url}/${locale}/blog/${slug}/`;
const related = comparisonSlugs.filter((item) => item !== slug).slice(0, 2);
const jsonLd = { "@context": "https://schema.org", "@graph": [
  { "@type": "Article", headline: copy.title, description: copy.description, mainEntityOfPage: url, inLanguage: locale === "zh-hant" ? "zh-Hant" : locale === "pt-br" ? "pt-BR" : locale, author: { "@type": "Organization", name: site.author, url: `${site.url}/about/` }, publisher: { "@type": "Organization", name: site.name, url: site.url }, about: ["Spicy Chat AI", slug] },
  { "@type": "BreadcrumbList", itemListElement: [
    { "@type": "ListItem", position: 1, name: labels.home, item: `${site.url}/${locale}/` },
    { "@type": "ListItem", position: 2, name: labels.blog, item: `${site.url}/${locale}/blog/` },
    { "@type": "ListItem", position: 3, name: copy.title, item: url },
  ] },
] };
---
<BaseLayout locale={locale} title={`${copy.title} | Spicy Chat AI`} description={copy.description} type="article" noindex={!isPublishedLocale(locale)} jsonLd={jsonLd}>
  <article class="article-shell localized-article">
    <header class="article-header"><nav class="breadcrumbs" aria-label={labels.navigation}><a href={`/${locale}/`}>{labels.home}</a><span>/</span><a href={`/${locale}/blog/`}>{labels.blog}</a><span>/</span><span>VS</span></nav><a class="back-link" href={`/${locale}/blog/`}>← {labels.allArticles}</a><h1>{copy.title}</h1><p>{copy.description}</p></header>
    <div class="article-layout">
      <aside><div class="toc"><span>{labels.blog}</span>{copy.sections.map(([heading], index) => <a href={`#section-${index + 1}`}>{heading}</a>)}<a href="#sources">{labels.sources}</a></div></aside>
      <div>
        <div class="article-content" id="article-content">
          <p class="article-lede">{copy.intro}</p>
          <div class="compare-table localized-table"><table><thead><tr><th scope="col">{labels.compare}</th><th scope="col">SpicyChat</th><th scope="col">{slug.includes("character-ai") ? "Character.AI" : slug.includes("janitor") ? "Janitor AI" : slug.includes("crushon") ? "CrushOn AI" : slug.includes("polybuzz") ? "PolyBuzz" : "GirlfriendGPT"}</th></tr></thead><tbody>{copy.dimensions.map(([dimension, first, second]) => <tr><th scope="row">{dimension}</th><td data-label="SpicyChat">{first}</td><td data-label={slug.includes("character-ai") ? "Character.AI" : slug.includes("janitor") ? "Janitor AI" : slug.includes("crushon") ? "CrushOn AI" : slug.includes("polybuzz") ? "PolyBuzz" : "GirlfriendGPT"}>{second}</td></tr>)}</tbody></table></div>
          {copy.sections.map(([heading, body], index) => <section id={`section-${index + 1}`}><h2>{heading}</h2><p>{body}</p></section>)}
          <section class="article-verdict"><h2>{labels.verdict}</h2><p>{copy.verdict}</p></section>
        </div>
        <section class="sources" id="sources"><h2>{labels.sources}</h2><ul>{comparisonSources[slug].map((source) => <li><a href={source.url} rel="noopener" target="_blank">{source.name}</a></li>)}</ul></section>
      </div>
    </div>
  </article>
  <section class="section related"><div class="section-head"><div><div class="section-label">{labels.more}</div><h2>{labels.allArticles}</h2></div></div><div class="post-grid compact">{related.map((item, index) => <LocalizedPostCard locale={locale} slug={item} index={index} compact />)}</div></section>
</BaseLayout>
