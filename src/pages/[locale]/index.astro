---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import LocalizedPostCard from "../../components/LocalizedPostCard.astro";
import { activeLocales } from "../../data/active-locales";
import { comparisonSlugs, isPublishedLocale, locales, type Locale } from "../../data/locales";
import { localizedPages } from "../../data/localized-pages";
import { site } from "../../data/site";
import heroImage from "../../assets/spicychat-user-red-lounge.jpg";
import secondaryImage from "../../assets/spicychat-user-black-lounge.jpg";

export function getStaticPaths() { return activeLocales().map(({ slug }) => ({ params: { locale: slug } })); }
const locale = Astro.params.locale as Locale;
const edition = localizedPages[locale];
if (!edition) throw new Error(`Missing localized homepage: ${locale}`);
const copy = edition.home;
const labels = edition.ui;
const lang = locales.find(({ slug }) => slug === locale)!.lang;
const imageAlts: Record<Locale, [string, string]> = {
  ja: ["赤いラウンジで撮影した成人モデルの編集用ポートレート", "黒い衣装を着た成人モデルのラウンジ写真"],
  ko: ["붉은 라운지에서 촬영한 성인 모델의 편집용 인물 사진", "검은 의상을 입은 성인 모델의 라운지 사진"],
  "zh-hant": ["紅色休息室中成年模特兒的編輯用肖像", "穿著黑色服裝的成年模特兒照片"],
  es: ["Retrato editorial de una modelo adulta en un salón rojo", "Modelo adulta vestida de negro en un salón"],
  "pt-br": ["Retrato editorial de uma modelo adulta em um lounge vermelho", "Modelo adulta com roupa preta em um lounge"],
  ru: ["Редакционный портрет взрослой модели в красном зале", "Взрослая модель в чёрном наряде в лаунж-зоне"],
  de: ["Redaktionelles Porträt eines erwachsenen Models in roter Lounge", "Erwachsenes Model in schwarzer Kleidung in einer Lounge"],
  fr: ["Portrait éditorial d'un mannequin adulte dans un salon rouge", "Mannequin adulte habillé en noir dans un salon"],
  ar: ["صورة تحريرية لعارضة بالغة في صالة حمراء", "عارضة بالغة ترتدي ملابس سوداء في صالة"],
};
const url = `${site.url}/${locale}/`;
const jsonLd = { "@context": "https://schema.org", "@graph": [
  { "@type": "WebPage", "@id": `${url}#webpage`, name: "Spicy Chat AI", url, description: copy.description, inLanguage: lang, isPartOf: { "@type": "WebSite", name: site.name, url: site.url } },
  { "@type": "FAQPage", inLanguage: lang, mainEntity: copy.faq.items.map(({ question, answer }) => ({ "@type": "Question", name: question, acceptedAnswer: { "@type": "Answer", text: answer } })) },
] };
---
<BaseLayout locale={locale} title="Spicy Chat AI" description={copy.description} noindex={!isPublishedLocale(locale)} jsonLd={jsonLd}>
  <div class="localized-home">
    <section class="hero roleplay-hero">
      <Image class="hero-image" src={heroImage} alt={imageAlts[locale][0]} widths={[640,960,1280,1536]} sizes="100vw" loading="eager" fetchpriority="high" quality={86} />
      <div class="hero-glow"></div>
      <div class="hero-copy"><div class="kicker">{copy.hero.kicker}</div><h1>Spicy Chat <span>AI</span></h1><p class="hero-tagline">{copy.hero.tagline}</p><p>{copy.hero.body}</p><div class="hero-actions"><a class="button primary" href="#test">{copy.hero.primary} <Icon name="spark" /></a><a class="button ghost" href={`/${locale}/blog/`}>{copy.hero.secondary}</a></div><div class="hero-trust"><span>{labels.independent}</span><span>{labels.adults}</span></div></div>
    </section>
    <section class="section intent-grid" id="about"><div><div class="section-label">{copy.intro.kicker}</div><h2>{copy.intro.heading}</h2></div><div class="intent-copy"><p class="lead">{copy.intro.lead}</p><p>{copy.intro.body}</p></div></section>
    <section class="section journey" id="how-it-works"><div class="section-head"><div><div class="section-label">{copy.journey.kicker}</div><h2>{copy.journey.heading}</h2></div><p>{copy.journey.description}</p></div><div class="journey-grid">{copy.journey.cards.map((card, index) => <article><b>0{index + 1}</b><span>{card.label}</span><h3>{card.heading}</h3><p>{card.body}</p></article>)}</div></section>
    <section class="section" id="features"><div class="section-head"><div><div class="section-label">{copy.controls.kicker}</div><h2>{copy.controls.heading}</h2></div><p>{copy.controls.description}</p></div><div class="feature-grid spicy-feature-grid">{copy.controls.cards.map((card, index) => <article class="feature"><div class="feature-icon"><Icon name={["chat","spark","lock","heart","wand"][index] as "chat"|"spark"|"lock"|"heart"|"wand"} /></div><small>{card.label}</small><h3>{card.heading}</h3><p>{card.body}</p></article>)}</div></section>
    <section class="section story" id="test"><div class="story-copy"><div class="section-label">{copy.test.kicker}</div><h2>{copy.test.heading}</h2><p>{copy.test.description}</p><ol class="steps">{copy.test.steps.map((step, index) => <li><span>0{index + 1}</span><div><strong>{step.heading}</strong><p>{step.body}</p></div></li>)}</ol></div></section>
    <section class="section" id="compare"><div class="section-head"><div><div class="section-label">{copy.comparison.kicker}</div><h2>{copy.comparison.heading}</h2></div><p>{copy.comparison.description}</p></div><div class="compare-table localized-table"><table><thead><tr>{copy.comparison.columns.map((name) => <th scope="col">{name}</th>)}<th scope="col">{labels.read}</th></tr></thead><tbody><tr><th scope="row">{copy.comparison.baseline[0]}</th><td data-label={copy.comparison.columns[1]}>{copy.comparison.baseline[1]}</td><td data-label={copy.comparison.columns[2]}>{copy.comparison.baseline[2]}</td><td data-label={labels.read}>—</td></tr>{comparisonSlugs.map((slug) => <tr><th scope="row">{copy.comparison.options[slug][0]}</th><td data-label={copy.comparison.columns[1]}>{copy.comparison.options[slug][1]}</td><td data-label={copy.comparison.columns[2]}>{copy.comparison.options[slug][2]}</td><td data-label={labels.read}><a href={`/${locale}/blog/${slug}/`}>{labels.read} →</a></td></tr>)}</tbody></table></div></section>
    <section class="section privacy" id="privacy"><div class="privacy-copy"><div class="section-label">{copy.privacy.kicker}</div><h2>{copy.privacy.heading}</h2><p>{copy.privacy.body}</p><a class="button ghost" href={`/${locale}/privacy/`}>{labels.privacy} <Icon name="arrow" /></a></div><div class="privacy-card"><span>{labels.adults}</span><h3>{copy.privacy.heading}</h3><ul>{copy.privacy.checks.map((item, index) => <li><b>0{index + 1}</b><span>{item}</span></li>)}</ul></div></section>
    <section class="section seo-copy"><div class="section-head"><div><div class="section-label">{copy.research.kicker}</div><h2>{copy.research.heading}</h2></div><p>{copy.research.description}</p></div><figure class="seo-visual"><Image src={secondaryImage} alt={imageAlts[locale][1]} widths={[640,960,1280]} sizes="(max-width: 640px) 100vw, 1200px" loading="lazy" quality={84} /></figure><div class="localized-research">{copy.research.blocks.map((block) => <article><h3>{block.heading}</h3>{block.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</article>)}</div></section>
    <section class="section"><div class="section-head"><div><div class="section-label">{copy.blog.kicker}</div><h2>{copy.blog.heading}</h2></div><a class="button ghost" href={`/${locale}/blog/`}>{copy.blog.cta} <Icon name="arrow" /></a></div><div class="post-grid">{comparisonSlugs.map((slug, index) => <LocalizedPostCard locale={locale} slug={slug} index={index} />)}</div></section>
    <section class="section faq"><div><div class="section-label">{copy.faq.kicker}</div><h2>{copy.faq.heading}</h2></div><div class="faq-list">{copy.faq.items.map(({ question, answer }) => <details><summary>{question}<span>+</span></summary><p>{answer}</p></details>)}</div></section>
    <section class="section final-cta"><div><div class="section-label">{copy.final.kicker}</div><h2>{copy.final.heading}</h2><p>{copy.final.body}</p></div><a class="button primary" href={site.officialUrl} rel="noopener" target="_blank">{copy.final.cta} <Icon name="arrow" /></a></section>
  </div>
</BaseLayout>
