---
import{getCollection}from"astro:content";import BaseLayout from"../../layouts/BaseLayout.astro";import PostCard from"../../components/PostCard.astro";import{site}from"../../data/site";const posts=(await getCollection("blog")).sort((a,b)=>b.data.publishDate.valueOf()-a.data.publishDate.valueOf());const jsonLd={"@context":"https://schema.org","@type":"CollectionPage",name:"Spicy chat ai VS comparisons",url:`${site.url}/blog/`,description:"Focused spicy chat ai comparisons covering features, strengths, weaknesses, privacy, control, and cost.",hasPart:posts.map((post)=>({"@type":"Article",headline:post.data.title,url:`${site.url}/blog/${post.id}/`,datePublished:post.data.publishDate.toISOString()}))};
---
<BaseLayout title="Spicy Chat AI comparisons" description="independent Spicy Chat AI comparisons covering Character.AI, Janitor AI, CrushOn AI, PolyBuzz, and GirlfriendGPT with model, memory, privacy, control, and cost tradeoffs." keywords={["spicy chat ai","spicy chat ai comparison","SpicyChat vs Character AI","SpicyChat vs Janitor AI","SpicyChat alternatives"]} jsonLd={jsonLd}><section class="page-hero"><div class="ambient-orb"></div><span>SPICY CHAT AI COMPARISON LIBRARY</span><h1>Spicy Chat AI comparisons</h1><p>Focused VS articles, each organized around a different roleplay decision: expression rules, setup, credits, discovery, or companion media.</p></section><section class="section blog-list"><div class="post-grid">{posts.map((post,index)=><PostCard post={post} index={index}/>)}</div></section></BaseLayout>
