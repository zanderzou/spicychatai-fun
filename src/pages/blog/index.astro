---
import{getCollection}from"astro:content";import BaseLayout from"../../layouts/BaseLayout.astro";import PostCard from"../../components/PostCard.astro";import{site}from"../../data/site";const posts=(await getCollection("blog")).sort((a,b)=>b.data.publishDate.valueOf()-a.data.publishDate.valueOf());const jsonLd={"@context":"https://schema.org","@type":"CollectionPage",name:"SpicyChat AI comparisons and safety guides",url:`${site.url}/blog/`,description:"Independent SpicyChat AI comparisons, memory explanations, safety checklists, and roleplay research.",hasPart:posts.map((post)=>({"@type":"Article",headline:post.data.title,url:`${site.url}/blog/${post.id}/`,datePublished:post.data.publishDate.toISOString()}))};
---
<BaseLayout title="SpicyChat AI Blog: Models, Memory & Comparisons" description="Independent SpicyChat AI guides covering roleplay characters, models, context memory, personas, privacy, pricing, Character.AI, Janitor AI, and alternatives." keywords={["SpicyChat AI blog","SpicyChat review","SpicyChat comparison","uncensored AI roleplay","SpicyChat safety"]} jsonLd={jsonLd}><section class="page-hero"><div class="ambient-orb"></div><span>SPICYCHAT AI RESEARCH LIBRARY</span><h1>Better characters.<br/>Smarter story controls.</h1><p>Original decision guides for SpicyChat AI and the wider roleplay category—written for adults who want clear model, memory, privacy, and cost tradeoffs.</p></section><section class="section blog-list"><div class="post-grid">{posts.map((post,index)=><PostCard post={post} index={index}/>)}</div></section></BaseLayout>
