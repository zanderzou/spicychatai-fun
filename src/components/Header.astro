---
import Icon from "./Icon.astro";
import { site } from "../data/site";
import { activeLocales } from "../data/active-locales";
import { languageAlternates, locales, routeFor, type Locale } from "../data/locales";
import { localizedPages } from "../data/localized-pages";
import { promotionCopy, promotionUrl } from "../data/promotions";
interface Props { locale?: Locale; }
const { locale } = Astro.props;
const copy = locale ? localizedPages[locale]?.ui : null;
const home = routeFor(locale ?? "");
const blog = routeFor(locale ?? "", "blog");
const availableLocales = /^\/404(?:\/|$)/.test(Astro.url.pathname) ? [] : activeLocales();
const alternates = languageAlternates(Astro.url.pathname, availableLocales.map(({ slug }) => slug));
const options = [{ lang: "en", label: "English", href: alternates[0].href }, ...availableLocales.map((item) => ({ lang: item.lang, label: item.label, href: alternates.find((entry) => entry.lang === item.lang)!.href }))];
const current = locale ? locales.find((item) => item.slug === locale)!.lang : "en";
const currentLabel = locale === "zh-hant" ? "繁中" : current.toUpperCase();
---
<header class:list={["site-header", availableLocales.length > 0 && "has-locales"]}>
  <a class="brand" href={home} aria-label="Spicy Chat AI home"><span class="brand-icon">SC</span><strong>Spicy Chat <span>AI</span></strong></a>
  <nav aria-label={copy?.navigation ?? "Main navigation"}>
    <a href={`${home}#how-it-works`}>{copy?.start ?? "Start"}</a>
    <a href={`${home}#features`}>{copy?.controls ?? "Models & memory"}</a>
    <a href={`${home}#compare`}>{copy?.compare ?? "Compare"}</a>
    <a href={blog}>{copy?.blog ?? "Blog"}</a>
  </nav>
  <a class="official-link" href={promotionUrl} rel="sponsored nofollow noopener" target="_blank">{locale ? promotionCopy[locale].label : "Open official SpicyChat"} <Icon name="arrow" /></a>
  {availableLocales.length > 0 && <details class="language-menu"><summary aria-label={copy?.language ?? "Language"}>{currentLabel}</summary><div>{options.map((item) => <a href={item.href} lang={item.lang} aria-current={item.lang === current ? "page" : undefined}>{item.label}</a>)}</div></details>}
  <button class="menu-button" type="button" aria-label={copy?.menu ?? "Open menu"} aria-expanded="false" data-menu-button data-open-label={copy?.menu ?? "Open menu"} data-close-label={copy?.closeMenu ?? "Close menu"}><Icon name="menu" /></button>
  <div class="mobile-nav" data-mobile-nav>
    <a href={`${home}#how-it-works`}>{copy?.start ?? "Start"}</a>
    <a href={`${home}#features`}>{copy?.controls ?? "Models & memory"}</a>
    <a href={`${home}#compare`}>{copy?.compare ?? "Compare"}</a>
    <a href={blog}>{copy?.blog ?? "Blog"}</a>
    <a href="https://spicy-box.com/?utm_ref=c546b6e92223b411" rel={locale ? "sponsored nofollow noopener noreferrer" : "noopener"} target="_blank">{locale ? promotionCopy[locale].label : "Official SpicyChat"}</a>
  </div>
</header>
