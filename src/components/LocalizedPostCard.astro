---
import Icon from "./Icon.astro";
import { localizedArticles } from "../data/localized-articles";
import { localizedPages } from "../data/localized-pages";
import type { ComparisonSlug, Locale } from "../data/locales";
interface Props { locale: Locale; slug: ComparisonSlug; index: number; compact?: boolean; }
const { locale, slug, index, compact = false } = Astro.props;
const article = localizedArticles[locale]?.[slug];
const labels = localizedPages[locale]?.ui;
if (!article || !labels) throw new Error(`Missing article/card translation: ${locale} / ${slug}`);
const icons = ["heart", "chat", "lock"] as const;
const accents = ["rose", "violet", "amber"] as const;
---
<article class:list={["post-card", accents[index % accents.length]]}>
  <a href={`/${locale}/blog/${slug}/`}>
    {!compact && <div class="post-visual"><span>VS 0{index + 1}</span><Icon name={icons[index % icons.length]} /></div>}
    <div class="post-copy"><div class="post-meta"><span>VS 0{index + 1}</span></div><h3>{article.title}</h3><p>{article.description}</p><strong>{labels.read} <Icon name="arrow" /></strong></div>
  </a>
</article>
